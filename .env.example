# Finora Environment Variables
SECRET_KEY=finora-super-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL / SQLite)
# To use MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/finora_db
# Or fill individual fields:
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=finora_db

# If not provided or MySQL is not running, Finora automatically defaults to SQLite:
# DATABASE_URL=sqlite:///finora.db
